# ── ARTEK backend – production environment (EXAMPLE) ─────────────
# Copy to .env on the server and replace every placeholder.
# Never commit the real .env.

# Database password (used by docker-compose.prod.yml for both services)
DB_PASSWORD=change-me

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# CORS – one or more origins separated by commas
CLIENT_URL=https://example.com,https://www.example.com
# Optional regex for extra origins (e.g. Vercel preview deployments)
CORS_ORIGIN_REGEX=^https://artek-frontend-.*-intracyber-s-projects\.vercel\.app$

# Cookie – lax | strict | none (none forces secure)
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.example.com

# Email (quote notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=change-me
SMTP_PASS=change-me
QUOTE_TO_EMAIL=sales@example.com

# Super admin seed
SUPERADMIN_NAME=superadmin
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change-me

# Uploads bind mount on the host
UPLOADS_HOST_DIR=/var/www/artek/uploads
